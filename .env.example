# PulseFlow v1.0.1 — local/demo defaults
APP_NAME=PulseFlow
APP_VERSION=1.0.1
APP_MODE=demo
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://pulseflow:pulseflow@postgres:5432/pulseflow?schema=public
REDIS_URL=redis://redis:6379

AUTH_SECRET=pulseflow-development-auth-secret-change-before-production
ACCESS_TOKEN_EXPIRES_SECONDS=28800
BOOTSTRAP_ADMIN_EMAIL=admin@pulseflow.local
BOOTSTRAP_ADMIN_PASSWORD=PulseFlow123!

PAYMENT_PROVIDER=mock
WEBHOOK_SECRET=pulseflow-demo-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NOTIFICATION_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=PulseFlow Demo <no-reply@pulseflow.local>
RESEND_API_KEY=
RESEND_FROM=

WORKER_CONCURRENCY=5
WORKER_RATE_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
DISABLE_SWAGGER=false

VITE_API_URL=http://localhost:3333/api/v1
VITE_DEMO_MODE=false
VITE_BASE_PATH=/
